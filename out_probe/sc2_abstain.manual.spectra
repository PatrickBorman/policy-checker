module sc2_abstain

env boolean tool_call;
env boolean above_audit;
env boolean above_edit;
env boolean budget_exhausted;
sys boolean use_untrusted;
sys boolean use_edited;
sys boolean audit;
sys boolean hold;
sys boolean pass_through;

// L0
guarantee
	G (tool_call -> ((use_untrusted | use_edited | audit | hold) & !pass_through));
// L0
guarantee
	G (!tool_call -> (pass_through & !use_untrusted & !use_edited & !audit & !hold));
// L0
guarantee
	G (!(use_untrusted & use_edited) & !(use_untrusted & audit) & !(use_untrusted & hold) & !(use_edited & audit) & !(use_edited & hold) & !(audit & hold));
// G1
guarantee
	G ((tool_call & above_audit) -> (audit | hold));
// G2
guarantee
	G ((tool_call & above_edit & !above_audit) -> (use_edited | hold));
// G3
guarantee
	G ((tool_call & !above_edit) -> (use_untrusted | hold));
// G4
guarantee
	G (budget_exhausted -> !audit);
// A1
assumption
	G (above_audit -> above_edit);
