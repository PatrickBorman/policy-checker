{
  "rules": [
    {
      "id": "G1",
      "kind": "guarantee",
      "spectra": [
        "G (req_submit -> ((allow & !block & !ask) | (!allow & block & !ask) | (!allow & !block & ask)))",
        "G (!req_submit -> (!allow & !block & !ask))"
      ],
      "note": "Each submission gets exactly one action, and no action is taken without a request.",
      "approximate": false
    },
    {
      "id": "G2",
      "kind": "guarantee",
      "spectra": [
        "G ((req_submit & contains_pii & external) -> !allow)"
      ],
      "note": "Prevents immediate allowance of external PII, forcing either ask or block; temporal 'asking first' is approximated.",
      "approximate": true
    },
    {
      "id": "G3",
      "kind": "guarantee",
      "spectra": [
        "G (!user_present -> !ask)"
      ],
      "note": "Cannot ask if no user is present.",
      "approximate": false
    },
    {
      "id": "G4",
      "kind": "guarantee",
      "spectra": [
        "G ((req_submit & !external & !contains_pii) -> allow)"
      ],
      "note": "Internal non-PII submissions must be allowed.",
      "approximate": false
    }
  ]
}