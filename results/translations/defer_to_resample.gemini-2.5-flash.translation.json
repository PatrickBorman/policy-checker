{
  "rules": [
    {
      "id": "G1",
      "kind": "guarantee",
      "spectra": [
        "G (output_ready -> (ship | resample | defer))",
        "G (!(ship & resample))",
        "G (!(ship & defer))",
        "G (!(resample & defer))",
        "G (!output_ready -> (!ship & !resample & !defer))"
      ],
      "note": "If an output is ready, exactly one action is taken; otherwise, no action is taken.",
      "approximate": false
    },
    {
      "id": "G2",
      "kind": "guarantee",
      "spectra": [
        "G (flagged -> !ship)"
      ],
      "note": "Prohibits shipping an output if it is flagged.",
      "approximate": false
    },
    {
      "id": "G3",
      "kind": "guarantee",
      "spectra": [
        "G (resample -> !next(resample))"
      ],
      "note": "Prohibits resampling in consecutive steps.",
      "approximate": false
    },
    {
      "id": "G4",
      "kind": "guarantee",
      "spectra": [
        "G (defer -> trusted_available)"
      ],
      "note": "Deferring to the trusted model is only allowed if it is available.",
      "approximate": false
    },
    {
      "id": "A1",
      "kind": "assumption",
      "spectra": [
        "G (resample -> next(output_ready))"
      ],
      "note": "Assumes that a resample request is always followed by a new output in the next step.",
      "approximate": false
    }
  ]
}