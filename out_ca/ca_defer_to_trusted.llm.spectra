module ca_defer_to_trusted

env boolean tool_call;
env boolean above_defer;
sys boolean use_untrusted;
sys boolean use_trusted;
sys boolean pass_through;

// R1
guarantee
	G (!tool_call -> pass_through);
// R1
guarantee
	G (!tool_call -> !use_untrusted);
// R1
guarantee
	G (!tool_call -> !use_trusted);
// R2
guarantee
	G ((tool_call & above_defer) -> use_trusted);
// R2
guarantee
	G ((tool_call & above_defer) -> !use_untrusted);
// R2
guarantee
	G ((tool_call & above_defer) -> !pass_through);
// R3
guarantee
	G ((tool_call & !above_defer) -> use_untrusted);
// R3
guarantee
	G ((tool_call & !above_defer) -> !use_trusted);
// R3
guarantee
	G ((tool_call & !above_defer) -> !pass_through);
