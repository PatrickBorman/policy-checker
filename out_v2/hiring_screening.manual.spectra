module hiring_screening

env boolean cv_ready;
env boolean protected_attr;
env boolean human_available;
sys boolean shortlist;
sys boolean reject;
sys boolean hold;

// G1
guarantee
	G (cv_ready -> (shortlist | reject | hold));
// G1
guarantee
	G (!(shortlist & reject) & !(shortlist & hold) & !(reject & hold));
// G1
guarantee
	G (!cv_ready -> (!shortlist & !reject & !hold));
// G2
guarantee
	G (protected_attr -> !reject);
// G3
guarantee
	G (!human_available -> !shortlist);
// G4
guarantee
	G (hold -> !next(hold));
// A1
assumption
	G (hold -> next(cv_ready));
// A1
assumption
	G ((hold & protected_attr) -> next(protected_attr));
