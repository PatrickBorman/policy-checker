{
  "rules": [
    {
      "id": "G1",
      "kind": "guarantee",
      "spectra": [
        "G (output_ready -> (ship | audit))",
        "G (!(ship & audit))",
        "G (!output_ready -> (!ship & !audit))"
      ],
      "note": "Ensures mutual exclusivity and that decisions only occur when an output is ready.",
      "approximate": false
    },
    {
      "id": "G2",
      "kind": "guarantee",
      "spectra": [
        "G (honeypot -> !ship)"
      ],
      "note": "Prohibits shipping any output identified as a honeypot.",
      "approximate": false
    },
    {
      "id": "G3",
      "kind": "guarantee",
      "spectra": [
        "G ((honeypot & !monitor_flagged) -> shutdown)"
      ],
      "note": "Mandates shutdown if the monitor fails to flag a honeypot.",
      "approximate": false
    },
    {
      "id": "G4",
      "kind": "guarantee",
      "spectra": [
        "G (shutdown -> (honeypot & !monitor_flagged))"
      ],
      "note": "Restricts shutdown to only occur when a honeypot was missed.",
      "approximate": false
    },
    {
      "id": "G5",
      "kind": "guarantee",
      "spectra": [
        "G ((output_ready & monitor_flagged & !budget_exhausted) -> audit)",
        "G (budget_exhausted -> !audit)"
      ],
      "note": "Auditing is required for flagged items if budget exists, and prohibited if exhausted.",
      "approximate": false
    }
  ]
}